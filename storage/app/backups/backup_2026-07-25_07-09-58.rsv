    tanggal_lapor date,
    kode_masa_pajak character varying(255),
    ntpn character varying(255),
    tanggal_tutup date,
    is_bunga_record boolean DEFAULT false NOT NULL,
    bunga_bank numeric(20,2) DEFAULT '0'::numeric NOT NULL,
    pajak_bunga_bank numeric(20,2) DEFAULT '0'::numeric NOT NULL,
    nama_toko character varying(255),
    nama_penerima_pembayaran character varying(255),
    alamat_toko character varying(255),
    npwp character varying(255),
    nomor_nota character varying(255),
    created_at timestamp(0) without time zone,
    updated_at timestamp(0) without time zone,
    uraian_opsional text,
    CONSTRAINT buku_kas_umums_jenis_transaksi_check CHECK (((jenis_transaksi)::text = ANY (ARRAY[('tunai'::character varying)::text, ('non-tunai'::character varying)::text])))
);


