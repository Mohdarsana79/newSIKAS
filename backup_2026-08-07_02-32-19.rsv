    tanggal_transaksi date NOT NULL,
    kode_kegiatan_id bigint,
    rekening_belanja_id bigint,
    uraian text,
    jenis_transaksi character varying(255) NOT NULL,
    anggaran numeric(20,2) DEFAULT '0'::numeric NOT NULL,
    dibelanjakan numeric(20,2) DEFAULT '0'::numeric NOT NULL,
    total_transaksi_kotor numeric(20,2) DEFAULT '0'::numeric NOT NULL,
    pajak character varying(255),
